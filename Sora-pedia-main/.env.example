# ============================================================
# SORA PEDIA - Environment Variables
# Salin nama-nama ini ke Vercel: Project > Settings > Environment Variables
# JANGAN commit file .env yang berisi nilai asli ke GitHub.
# ============================================================

# --- Umum ---------------------------------------------------
SITE_NAME=Sora Pedia
# URL website kamu (untuk callback webhook). Contoh: https://sorapedia.vercel.app
SITE_URL=https://GANTI-DENGAN-DOMAIN-KAMU.vercel.app
# String acak panjang (minimal 32 karakter) untuk menandatangani sesi login
SESSION_SECRET=GANTI_DENGAN_STRING_ACAK_PANJANG

# --- Admin panel (login di /admin) --------------------------
ADMIN_EMAIL=email-admin-kamu@gmail.com
ADMIN_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT

# --- Firebase Realtime Database -----------------------------
FIREBASE_DATABASE_URL=https://sorapay-53345-default-rtdb.asia-southeast1.firebasedatabase.app
# Ambil dari Firebase Console > Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=sorapay-53345
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@sorapay-53345.iam.gserviceaccount.com
# Tempel private_key apa adanya (boleh dengan \n literal)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# (Alternatif) isi seluruh JSON service account dalam satu baris, lalu kosongkan tiga variabel di atas
# FIREBASE_SERVICE_ACCOUNT=

# --- Deposit otomatis (BuatQRIS) ----------------------------
BUATQRIS_ACCOUNT_ID=GANTI_ACCOUNT_ID
BUATQRIS_SECRET_TOKEN=GANTI_SECRET_TOKEN
BUATQRIS_BASE_URL=https://api.buatqris.site
# Signing Secret webhook (dasbor BuatQRIS > Open API > Webhook / Callback)
BUATQRIS_WEBHOOK_SECRET=GANTI_SIGNING_SECRET
# qris_one | qris_two | qris_three | qris_four
BUATQRIS_METHOD=qris_two
# buyer = biaya layanan ditagih ke pembeli (saldo user masuk penuh) | user = dipotong dari saldo merchant
BUATQRIS_FEE_BY=buyer
# 1 = mode sandbox (uji coba, tanpa uang asli). Kosongkan / 0 untuk produksi.
BUATQRIS_TEST=0
MIN_DEPOSIT=10000
MAX_DEPOSIT=5000000

# --- Provider layanan SMM (opsional) ------------------------
# API standar SMM panel v2 (key, action=add/status/services)
PROVIDER_API_URL=
PROVIDER_API_KEY=
# Kalau harga provider dalam USD isi kurs, misal 16500. Kalau sudah Rupiah isi 1.
PROVIDER_RATE_MULTIPLIER=1
# Markup keuntungan (persen) saat impor layanan dari provider
PROVIDER_MARKUP_PERCENT=20
